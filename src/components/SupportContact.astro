---
// The two ways to reach Pleinbook, as glass cards: email and Discord. Details live in src/data/site.ts.
import Icon from './Icon.astro';
import { contact, mailto } from '../data/site';
---

<div class="pb-contact not-content">
	<article class="pb-glass">
		<span class="glyph"><Icon name="mail" size={24} /></span>
		<h3>Email</h3>
		<p>For problems with the app, purchases or iCloud sync.</p>
		<a class="btn" href={mailto('Pleinbook support')}>{contact.email}</a>
	</article>
	<article class="pb-glass">
		<span class="glyph"><Icon name="message-circle" size={24} /></span>
		<h3>Discord</h3>
		<p>Ask other painters, share your pages and hear about updates first.</p>
		<a class="btn" href={contact.discord} rel="noopener">Join the Discord</a>
	</article>
</div>

<style>
	.pb-contact {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
		gap: 16px;
		/* Same rhythm as the Markdown around it: 1rem above, nothing extra below. */
		margin-block: 1rem 0;
	}
	article {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 8px;
		padding: 24px;
		border-radius: var(--pb-radius);
	}
	.glyph {
		display: grid;
		place-items: center;
		width: 48px;
		height: 48px;
		margin-bottom: 8px;
		border-radius: 14px;
		background: var(--pb-glass-bg-strong);
		box-shadow:
			var(--pb-glass-depth),
			inset 0 0 0 0.5px var(--pb-glass-edge);
		color: var(--pb-brand-blue);
	}
	:global([data-theme='dark']) .glyph {
		color: #7db7ff;
	}
	h3 {
		margin: 0;
		color: var(--pb-ink);
		font-family: var(--pb-font-display);
		font-variation-settings: var(--pb-display-axes);
		font-size: 23px;
		font-weight: 600;
		letter-spacing: -0.01em;
	}
	p {
		margin: 0 0 12px;
		color: var(--pb-ink-2);
		font-size: 16px;
		line-height: 1.5;
	}
	.btn {
		display: inline-flex;
		align-items: center;
		height: 44px;
		margin-top: auto;
		padding-inline: 18px;
		border-radius: 999px;
		background: var(--pb-cta-bg);
		color: var(--pb-cta-fg);
		font-size: 15px;
		font-weight: 600;
		text-decoration: none;
		box-shadow:
			var(--pb-glass-depth),
			var(--pb-glass-shadow);
	}
	.btn:hover {
		color: var(--pb-cta-fg);
		transform: translateY(-1px);
	}
</style>
