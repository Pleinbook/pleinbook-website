---
// The site's floating chrome, laid out like the app's: a capsule top bar at the top left and a
// lone corner button at the top right. Used on the homepage and, through ManualHeader.astro, on every
// manual page, where Starlight's search goes in the `search` slot. The current section is highlighted.
// There's no light/dark switch: the site follows the device's setting.
import Brushmark from './Brushmark.astro';
import AppStoreGlyph from './AppStoreGlyph.astro';
import { appStoreLink } from '../data/site';
import { publishedReleases } from '../data/changelog';
const store = appStoreLink();
// Changelog appears once the first release is published (src/changelog/).
const showChangelog = (await publishedReleases()).length > 0;
const path = Astro.url.pathname;
const here = (prefix: string) => (path.startsWith(prefix) ? { 'aria-current': 'page' as const } : {});
---

<div class="nav">
	<nav class="bar pb-glass" aria-label="Main">
		<a class="home" href="/" aria-label="Pleinbook home">
			<Brushmark size={26} />
			<span>Pleinbook</span>
		</a>
		<i class="div" aria-hidden="true"></i>
		<a class="link" href="/docs/" {...here('/docs/')}>Manual</a>
		<a class="link" href="/support/" {...here('/support/')}>Support</a>
		{showChangelog && (
			<a class="link wide" href="/changelog/" {...here('/changelog/')}>
				Changelog
			</a>
		)}
		{
			Astro.slots.has('search') && (
				<>
					<i class="div" aria-hidden="true" />
					<slot name="search" />
				</>
			)
		}
	</nav>
	<a class="corner pb-glass" href={store.href} aria-label={store.label} {...(store.external ? { rel: 'noopener' } : {})}>
		<AppStoreGlyph size={18} />
		<span>{store.corner}</span>
	</a>
</div>

<style>
	.nav {
		position: fixed;
		z-index: 50;
		top: 12px;
		inset-inline: 12px;
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 12px;
		pointer-events: none;
	}
	.nav > * {
		pointer-events: auto;
	}
	.bar {
		display: flex;
		align-items: center;
		gap: 4px;
		height: 52px;
		padding-inline: 10px 8px;
		border-radius: 999px;
		min-width: 0;
	}
	.home {
		display: flex;
		align-items: center;
		gap: 8px;
		padding: 6px 10px 6px 6px;
		border-radius: 999px;
		color: var(--pb-ink);
		font-weight: 650;
		font-size: 17px;
		letter-spacing: -0.01em;
		text-decoration: none;
	}
	.div {
		flex: none;
		width: 1px;
		height: 22px;
		margin-inline: 4px;
		background: var(--pb-rule);
	}
	.link {
		display: inline-flex;
		align-items: center;
		height: 38px;
		padding-inline: 12px;
		border: 0;
		border-radius: 999px;
		background: transparent;
		color: var(--pb-ink);
		font: 500 15px/1 var(--pb-font);
		text-decoration: none;
		white-space: nowrap;
		cursor: pointer;
		transition: background-color 0.15s;
	}
	.link:hover,
	.home:hover {
		background: var(--pb-glass-hover);
	}
	.link[aria-current='page'] {
		background: var(--pb-glass-bg-strong);
		box-shadow: var(--pb-glass-depth);
		font-weight: 600;
	}
	.corner {
		display: flex;
		align-items: center;
		gap: 8px;
		height: 52px;
		padding-inline: 18px;
		border-radius: 999px;
		color: var(--pb-ink);
		font: 600 15px/1 var(--pb-font);
		text-decoration: none;
		white-space: nowrap;
	}
	.corner:hover {
		background: var(--pb-glass-bg-strong);
	}

	@media (max-width: 720px) {
		.wide {
			display: none;
		}
		.corner span {
			display: none;
		}
		.corner {
			width: 52px;
			padding: 0;
			justify-content: center;
		}
	}
	@media (max-width: 420px) {
		.nav {
			top: 8px;
			inset-inline: 8px;
		}
		.home span {
			display: none;
		}
		.bar {
			gap: 2px;
			padding-inline: 6px;
		}
		.home {
			padding: 6px;
		}
		.div {
			margin-inline: 2px;
		}
		.link {
			padding-inline: 9px;
		}
	}
</style>
