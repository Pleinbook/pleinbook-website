---
// The homepage's floating chrome, laid out like the app's: a capsule top bar at the top left and a
// lone corner button at the top right.
import Brushmark from './Brushmark.astro';
import Icon from './Icon.astro';
import AppStoreGlyph from './AppStoreGlyph.astro';
import { appStoreLink } from '../data/site';
const store = appStoreLink();
---

<header class="nav">
	<nav class="bar pb-glass" aria-label="Main">
		<a class="home" href="/" aria-label="Pleinbook home">
			<Brushmark size={26} />
			<span>Pleinbook</span>
		</a>
		<i class="div" aria-hidden="true"></i>
		<a class="link" href="/docs/">Manual</a>
		<a class="link" href="/support/">Support</a>
		<a class="link wide" href="/changelog/">Changelog</a>
		<i class="div" aria-hidden="true"></i>
		<button class="icon-btn" type="button" data-theme-toggle aria-label="Switch between light and dark">
			<Icon name="contrast" size={20} />
		</button>
	</nav>
	<a class="corner pb-glass" href={store.href} aria-label={store.label} {...(store.external ? { rel: 'noopener' } : {})}>
		<AppStoreGlyph size={18} />
		<span>{store.corner}</span>
	</a>
</header>

<script>
	// Light/dark toggle, shared with the manual through Starlight's storage key.
	const KEY = 'starlight-theme';
	const root = document.documentElement;
	const current = () =>
		root.dataset.theme === 'dark' || root.dataset.theme === 'light'
			? root.dataset.theme
			: matchMedia('(prefers-color-scheme: dark)').matches
				? 'dark'
				: 'light';
	for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')) {
		btn.addEventListener('click', () => {
			const next = current() === 'dark' ? 'light' : 'dark';
			root.dataset.theme = next;
			try {
				localStorage.setItem(KEY, next);
			} catch {}
		});
	}
</script>

<style>
	.nav {
		position: fixed;
		z-index: 50;
		top: 12px;
		inset-inline: 12px;
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 12px;
		pointer-events: none;
	}
	.nav > * {
		pointer-events: auto;
	}
	.bar {
		display: flex;
		align-items: center;
		gap: 4px;
		height: 52px;
		padding-inline: 10px 8px;
		border-radius: 999px;
		min-width: 0;
	}
	.home {
		display: flex;
		align-items: center;
		gap: 8px;
		padding: 6px 10px 6px 6px;
		border-radius: 999px;
		color: var(--pb-ink);
		font-weight: 650;
		font-size: 17px;
		letter-spacing: -0.01em;
		text-decoration: none;
	}
	.div {
		flex: none;
		width: 1px;
		height: 22px;
		margin-inline: 4px;
		background: var(--pb-rule);
	}
	.link,
	.icon-btn {
		display: inline-flex;
		align-items: center;
		height: 38px;
		padding-inline: 12px;
		border: 0;
		border-radius: 999px;
		background: transparent;
		color: var(--pb-ink);
		font: 500 15px/1 var(--pb-font);
		text-decoration: none;
		white-space: nowrap;
		cursor: pointer;
		transition: background-color 0.15s;
	}
	.icon-btn {
		width: 38px;
		justify-content: center;
		padding: 0;
	}
	.link:hover,
	.icon-btn:hover,
	.home:hover {
		background: var(--pb-glass-hover);
	}
	.corner {
		display: flex;
		align-items: center;
		gap: 8px;
		height: 52px;
		padding-inline: 18px;
		border-radius: 999px;
		color: var(--pb-ink);
		font: 600 15px/1 var(--pb-font);
		text-decoration: none;
		white-space: nowrap;
	}
	.corner:hover {
		background: var(--pb-glass-bg-strong);
	}

	@media (max-width: 720px) {
		.wide {
			display: none;
		}
		.corner span {
			display: none;
		}
		.corner {
			width: 52px;
			padding: 0;
			justify-content: center;
		}
	}
	@media (max-width: 420px) {
		.nav {
			top: 8px;
			inset-inline: 8px;
		}
		.home span {
			display: none;
		}
		.link {
			padding-inline: 10px;
		}
	}
</style>
