---
// A screenshot of the app in the manual, shown like an iPad screen: rounded corners and a soft shadow.
// Screenshots come from the app repo's UITests/ManualScreenshotTests.swift (iPad mini, portrait).
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	src: ImageMetadata;
	alt: string;
	caption?: string;
	/** Display width in px, for crops narrower than a whole screen (default 400). */
	width?: number;
}
const { src, alt, caption, width = 400 } = Astro.props;
---

<figure class="pb-shot not-content" style={`--pb-shot-width: ${width}px`}>
	<Image src={src} alt={alt} widths={[width, width * 2]} sizes={`(min-width: 50rem) ${width}px, 80vw`} />
	{caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
	.pb-shot {
		margin: 1.5rem auto 0;
		max-width: min(100%, var(--pb-shot-width, 400px));
	}
	.pb-shot :global(img) {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 18px;
		box-shadow:
			0 0 0 0.5px var(--pb-glass-edge),
			var(--pb-glass-shadow);
	}
	figcaption {
		margin-top: 0.75rem;
		color: var(--pb-ink-3);
		font-size: 14px;
		line-height: 1.45;
		text-align: center;
	}
</style>
