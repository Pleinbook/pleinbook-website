---
// The App Store "A" (three crossed sticks), drawn for this site in the same line style as the icons.
// Use only to point at Pleinbook on the App Store. At launch, Apple's official badge may replace it.
interface Props {
	size?: number;
}
const { size = 20 } = Astro.props;
---

<svg
	class="pb-icon"
	width={size}
	height={size}
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width="1.9"
	stroke-linecap="round"
	aria-hidden="true"
	focusable="false"
>
	<path d="M10.3 4.4 18.1 17.9"></path>
	<path d="M13.7 4.4 7.6 15"></path>
	<path d="M6.5 17 6 17.9"></path>
	<path d="M4.8 14.6h8.3"></path>
	<path d="M15.6 14.6h3.6"></path>
</svg>
