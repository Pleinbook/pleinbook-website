---
// The kit ring as the app draws it (from a screenshot, Nov 2026): eight brush slots in a ring, each
// showing a stroke preview; the colour wheel and square in the middle; and value check, eyedropper and
// mirror as dark buttons along the bottom. It floats over a crop of the homepage's screenshot.
// The brush previews are drawn here in the style of the app's, not exported from it.
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import screenshot from '../assets/screenshots/drawing-placeholder.webp';

const WAVE = 'M10 42 C 18 14, 28 12, 32 32 S 46 52, 54 22';
const NAVY = '#4a5585';
// Clockwise from the top, as in the app.
const slots = [
	{ name: 'Pencil', kind: 'line', width: 1.6 },
	{ name: 'Ink', kind: 'line', width: 3.6 },
	{ name: 'Marker', kind: 'line', width: 7 },
	{ name: 'Soft airbrush', kind: 'soft' },
	{ name: 'Bristle', kind: 'bristle' },
	{ name: 'Wet blender', kind: 'wet-soft' },
	{ name: 'Wet round', kind: 'wet-line' },
	{ name: 'Palette knife', kind: 'wet-knife' },
] as const;
const uid = Math.random().toString(36).slice(2, 7);
---

<figure class="kit-card" aria-label="The kit ring: eight brushes around the Pencil tip, the colour picker in the middle, and value check, eyedropper and mirror buttons below.">
	<Image src={screenshot} alt="" class="kit-bg" widths={[640, 1040]} sizes="(min-width: 880px) 480px, 100vw" />
	<div class="stage" aria-hidden="true">
		{
			slots.map((s, i) => (
				<span class="slot" style={`--i:${i}`} title={s.name}>
					<svg viewBox="0 0 64 64">
						<defs>
							<clipPath id={`kc-${uid}-${i}`}>
								<circle cx="32" cy="32" r="32" />
							</clipPath>
							{s.kind === 'soft' && (
								<radialGradient id={`kg-${uid}`} cx="0.42" cy="0.38" r="0.7">
									<stop offset="0" stop-color="#fbfcff" />
									<stop offset="0.55" stop-color="#cfd6e6" />
									<stop offset="1" stop-color="#9aa6c0" />
								</radialGradient>
							)}
							{s.kind === 'wet-soft' && (
								<filter id={`kf-${uid}`} x="-20%" y="-20%" width="140%" height="140%">
									<feGaussianBlur stdDeviation="2.2" />
								</filter>
							)}
						</defs>
						<g clip-path={`url(#kc-${uid}-${i})`}>
							<rect width="64" height="64" fill="#f6f4ef" />
							{s.kind === 'line' && <path d={WAVE} fill="none" stroke={NAVY} stroke-width={s.width} stroke-linecap="round" />}
							{s.kind === 'soft' && <rect width="64" height="64" fill={`url(#kg-${uid})`} />}
							{s.kind === 'bristle' &&
								[-3.6, -1.8, 0, 1.8, 3.6].map((dy, j) => (
									<path
										d={WAVE}
										transform={`translate(0 ${dy})`}
										fill="none"
										stroke={j % 2 ? '#7a5c3c' : '#5e4630'}
										stroke-width="1.3"
										stroke-dasharray={j % 2 ? '9 2' : '14 3'}
										stroke-linecap="round"
										opacity="0.85"
									/>
								))}
							{s.kind.startsWith('wet') && (
								<>
									<rect y="16" width="64" height="17" fill="#e8574d" />
									<rect y="33" width="64" height="31" fill="#4a86de" />
								</>
							)}
							{s.kind === 'wet-soft' && (
								<g filter={`url(#kf-${uid})`}>
									<path d={WAVE} fill="none" stroke="#f6f4ef" stroke-width="9" stroke-linecap="round" opacity="0.75" />
									<path d={WAVE} transform="translate(2 3)" fill="none" stroke="#6b8fd8" stroke-width="7" stroke-linecap="round" />
								</g>
							)}
							{s.kind === 'wet-line' && <path d={WAVE} fill="none" stroke="#3f4f86" stroke-width="7" stroke-linecap="round" />}
							{s.kind === 'wet-knife' && (
								<path d="M12 18 L28 40 L46 20 L54 30" fill="none" stroke="#f6f4ef" stroke-width="8" stroke-linejoin="miter" stroke-linecap="square" />
							)}
						</g>
					</svg>
				</span>
			))
		}

		<span class="wheel">
			<span class="hue"></span>
			<span class="hue-knob"></span>
			<span class="sv">
				<span class="sv-knob"></span>
			</span>
		</span>

		<span class="btn" style="--a:112deg"><Icon name="contrast" size={22} /></span>
		<span class="btn" style="--a:90deg"><Icon name="pipette" size={22} /></span>
		<span class="btn" style="--a:68deg"><Icon name="flip-vertical-2" size={22} /></span>
	</div>
	<figcaption class="pb-glass">Double-tap Apple Pencil and your kit appears around the tip, with the colour picker in the middle.</figcaption>
</figure>

<style>
	.kit-card {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		margin: 0;
		padding: 20px 16px 16px;
		overflow: hidden;
		border-radius: var(--pb-radius);
		isolation: isolate;
		box-shadow:
			inset 0 0 0 0.5px var(--pb-glass-edge),
			var(--pb-glass-shadow);
	}
	.kit-card :global(.kit-bg) {
		position: absolute;
		inset: 0;
		z-index: -1;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 42% 55%;
		transform: scale(1.6);
	}

	/* Geometry, measured from the app: everything is a multiple of the ring radius --r. */
	.stage {
		--r: clamp(92px, 24vw, 124px);
		position: relative;
		width: calc(var(--r) * 2.45);
		height: calc(var(--r) * 2.8);
		flex: none;
	}
	.slot,
	.wheel,
	.btn {
		position: absolute;
		left: 50%;
		top: calc(var(--r) * 1.22);
		border-radius: 50%;
	}
	.slot {
		--d: calc(var(--r) * 0.4);
		width: var(--d);
		height: var(--d);
		margin: calc(var(--d) / -2) 0 0 calc(var(--d) / -2);
		transform: rotate(calc(var(--i) * 45deg - 90deg)) translateX(var(--r)) rotate(calc(var(--i) * -45deg + 90deg));
		box-shadow:
			0 0 0 1.5px rgb(120 120 125 / 0.55),
			0 3px 8px rgb(0 0 0 / 0.18);
	}
	.slot svg {
		display: block;
		width: 100%;
		height: 100%;
		border-radius: 50%;
	}

	.wheel {
		--w: calc(var(--r) * 1.37);
		width: var(--w);
		height: var(--w);
		margin: calc(var(--w) / -2) 0 0 calc(var(--w) / -2);
	}
	.hue {
		position: absolute;
		inset: 0;
		border-radius: 50%;
		background: conic-gradient(from 90deg, #f00, #ff0, #0f0, #0ff, #00f, #f0f, #f00);
		-webkit-mask: radial-gradient(circle, transparent 61%, #000 62%);
		mask: radial-gradient(circle, transparent 61%, #000 62%);
	}
	.hue-knob {
		position: absolute;
		left: 50%;
		top: 50%;
		width: 15%;
		height: 15%;
		margin: -7.5% 0 0 -7.5%;
		border: 2.5px solid #fff;
		border-radius: 50%;
		box-shadow: 0 1px 3px rgb(0 0 0 / 0.35);
		/* hue 28° (orange), measured clockwise from the right */
		transform: rotate(28deg) translateX(calc(var(--w) * 0.44)) rotate(-28deg);
	}
	.sv {
		position: absolute;
		left: 50%;
		top: 50%;
		width: 50%;
		height: 50%;
		margin: -25% 0 0 -25%;
		border-radius: 5px;
		background:
			linear-gradient(to bottom, transparent, #000),
			linear-gradient(to right, #fff, hsl(28 100% 50%));
	}
	.sv-knob {
		position: absolute;
		left: 61%;
		top: 46%;
		width: 18%;
		height: 18%;
		margin: -9% 0 0 -9%;
		border: 2px solid #111;
		border-radius: 50%;
	}

	.btn {
		--d: calc(var(--r) * 0.3);
		display: grid;
		place-items: center;
		width: var(--d);
		height: var(--d);
		margin: calc(var(--d) / -2) 0 0 calc(var(--d) / -2);
		background: rgb(45 32 18 / 0.78);
		-webkit-backdrop-filter: blur(10px);
		backdrop-filter: blur(10px);
		color: #fff;
		transform: rotate(var(--a)) translateX(calc(var(--r) * 1.42)) rotate(calc(-1 * var(--a)));
	}

	figcaption {
		max-width: 26rem;
		padding: 10px 16px;
		border-radius: 16px;
		color: var(--pb-ink);
		font-size: 15px;
		line-height: 1.4;
		text-align: center;
	}
</style>
