---
// Replaces Starlight's theme provider: the site always follows the device's light/dark setting
// (there is no theme switch), and changes live if the device switches while the page is open.
// Inline so the right theme is set before the page paints.
---

<script is:inline>
	window.StarlightThemeProvider = (() => {
		const mq = window.matchMedia('(prefers-color-scheme: dark)');
		const apply = () => (document.documentElement.dataset.theme = mq.matches ? 'dark' : 'light');
		apply();
		mq.addEventListener('change', apply);
		// Forget any choice saved by the old theme switch.
		try {
			localStorage.removeItem('starlight-theme');
		} catch {}
		return { updatePickers() {} };
	})();
</script>
