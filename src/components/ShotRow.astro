---
// A row of small crops from the app, each with a short label beneath, for side-by-side comparisons
// (e.g. the same paint laid with a Dry, a Wet and a Lasso brush). Stays one row at every width.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	items: { src: ImageMetadata; label: string; alt: string }[];
	caption?: string;
}
const { items, caption } = Astro.props;
---

<figure class="pb-shot-row not-content">
	<ul style={`--n: ${items.length}`}>
		{
			items.map((item) => (
				<li>
					<Image src={item.src} alt={item.alt} widths={[240, 480]} sizes="(min-width: 50rem) 200px, 30vw" />
					<span>{item.label}</span>
				</li>
			))
		}
	</ul>
	{caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
	.pb-shot-row {
		margin: 1.5rem auto 0;
		max-width: 40rem;
	}
	ul {
		display: grid;
		grid-template-columns: repeat(var(--n), minmax(0, 1fr));
		gap: clamp(0.5rem, 2.5vw, 1rem);
		margin: 0;
		padding: 0;
		list-style: none;
	}
	li {
		display: grid;
		gap: 0.5rem;
		justify-items: center;
	}
	li :global(img) {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 14px;
		box-shadow:
			0 0 0 0.5px var(--pb-glass-edge),
			var(--pb-glass-shadow);
	}
	span {
		color: var(--pb-ink);
		font-size: 14px;
		font-weight: 600;
	}
	figcaption {
		margin-top: 0.75rem;
		color: var(--pb-ink-3);
		font-size: 14px;
		line-height: 1.45;
		text-align: center;
	}
</style>
