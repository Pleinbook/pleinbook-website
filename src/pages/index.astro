---
// Holding page while the site is rebuilt: the floating top bar, a short note, and the footer links.
// The full homepage is parked in _home.astro (not published); rename it back to index.astro to restore it.
import '../styles/theme.css';
import SiteNav from '../components/SiteNav.astro';
import SiteFooterLinks from '../components/SiteFooterLinks.astro';
import Brushmark from '../components/Brushmark.astro';

const title = 'Pleinbook';
const description = 'Pleinbook is a painting sketchbook with paint that mixes like pigment. Our website is under construction.';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="preload" href="/fonts/fraunces-600-normal.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="icon" href="/favicon.ico" sizes="48x48" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="canonical" href={new URL('/', Astro.site)} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta name="theme-color" content="#f2ecdd" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#171614" media="(prefers-color-scheme: dark)" />
		<meta property="og:url" content={new URL('/', Astro.site)} />
		<meta property="og:image" content={new URL('/og.jpg', Astro.site)} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Pleinbook: Paint it once. Mix your colours. Turn the page." />
		<meta name="twitter:card" content="summary_large_image" />
		<script is:inline>
			// Follow the device's light/dark setting (there is no theme switch), live.
			(() => {
				const mq = matchMedia('(prefers-color-scheme: dark)');
				const apply = () => (document.documentElement.dataset.theme = mq.matches ? 'dark' : 'light');
				apply();
				mq.addEventListener('change', apply);
			})();
		</script>
	</head>
	<body class="pb-paper">
		<header>
			<SiteNav />
		</header>

		<main>
			<Brushmark size={72} tile />
			<h1>Pleinbook</h1>
			<p>Under Construction</p>
		</main>

		<footer class="foot">
			<div class="foot-inner pb-glass">
				<SiteFooterLinks />
			</div>
		</footer>
	</body>
</html>

<style>
	body {
		display: flex;
		flex-direction: column;
		min-height: 100vh;
		min-height: 100dvh;
		margin: 0;
		color: var(--pb-ink);
		font-family: var(--pb-font);
		-webkit-font-smoothing: antialiased;
	}
	main {
		flex: 1;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0;
		padding: 120px 16px 48px;
		text-align: center;
	}
	h1 {
		margin: 24px 0 0;
		font-family: var(--pb-font-display);
		font-variation-settings: var(--pb-display-axes);
		font-size: clamp(40px, 8vw, 64px);
		font-weight: 600;
		line-height: 1;
		letter-spacing: -0.02em;
	}
	p {
		max-width: 34ch;
		text-wrap: balance;
		margin: 16px 0 0;
		color: var(--pb-ink-2);
		font-size: clamp(18px, 2.4vw, 21px);
		line-height: 1.45;
	}
	.foot {
		width: 100%;
		max-width: 1120px;
		margin: 0 auto;
		padding: 0 16px 16px;
		box-sizing: border-box;
	}
	.foot-inner {
		padding: 4px 24px 20px;
		border-radius: var(--pb-radius);
	}
	.foot-inner :global(.pb-footer) {
		margin-top: 0;
		border-top: 0;
	}
</style>
